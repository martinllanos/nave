<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_nave" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pos.nave</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <!-- El pos_id sólo aplica a los cobros presenciales de Nave (terminal o QR) -->
                <field name="nave_terminal_id"
                       invisible="use_payment_terminal not in ('nave', 'nave_qr')"
                       required="use_payment_terminal in ('nave', 'nave_qr')"/>
            </xpath>
        </field>
    </record>
</odoo>
