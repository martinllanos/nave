<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario heredada de payment.provider -->
    <record id="payment_provider_form_nave" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.nave</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <!-- Ubicar nuestras credenciales dentro del grupo principal de credenciales de Odoo -->
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'nave'">
                    <field name="nave_client_id" 
                           required="code == 'nave' and state != 'disabled'"/>
                    <field name="nave_client_secret" 
                           password="True" 
                           required="code == 'nave' and state != 'disabled'"/>
                    <field name="nave_pos_id" 
                           required="code == 'nave' and state != 'disabled'"/>
                    <field name="nave_payment_link_pos_id"/>
                    <field name="nave_checkout_duration_minutes"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Plantilla de Redirección automática de Checkout para Odoo 17/18 -->
    <template id="redirect_form">
        <!--
            Al hacer clic en "Pagar" en el checkout de Odoo, se renderiza este formulario invisible
            y el navegador lo envía al Checkout de Nave. Va por GET porque la intención de pago ya
            fue creada server to server.

            Los parámetros con los que Nave identifica la intención van como campos y no en la
            acción: un envío GET descarta el query string de la acción y lo reemplaza por los
            campos, de modo que dejarlos en la URL hacía que el cliente llegara a Nave sin su
            intención y viera una pantalla en blanco.
        -->
        <form t-att-action="api_url" method="get">
            <input t-foreach="nave_redirect_params" t-as="param"
                   type="hidden"
                   t-att-name="param[0]"
                   t-att-value="param[1]"/>
        </form>
    </template>

</odoo>
